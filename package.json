{
  "name": "togglelogic",
  "version": "1.7.0-rc.10",
  "private": true,
  "description": "Owner-scoped skill-aware model routing for OpenClaw with learned policies, benchmark-capable Intelligence integration, bounded child execution, budget controls, audit records, and transparent cost estimates. Bring your own provider credentials. The separate ToggleLogic Intelligence package is privately distributed under its own license. Global and unattended enforcement require a future OpenClaw in-flight runtime safeguard.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "quality": "bash scripts/quality_gate.sh",
    "inventory:generate": "node scripts/generate-skill-inventory.mjs",
    "spend:generate": "node scripts/generate-spend-snapshot.mjs",
    "runtime:refresh": "node scripts/togglelogic-runtime-refresh.mjs"
  },
  "license": "LicenseRef-ToggleLogic-Free-Startup-Commercial-2.0",
  "author": "Motherboard, Inc. (https://togglelogic.ai/)",
  "homepage": "https://togglelogic.ai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ToggleLogic/togglelogic-free.git"
  },
  "bugs": { "url": "https://github.com/ToggleLogic/togglelogic-free/issues" },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "routing",
    "model-routing",
    "llm",
    "ai-gateway",
    "patent-pending",
    "togglelogic",
    "cost-optimization",
    "model-selection",
    "fallback",
    "orchestration"
  ],
  "files": [
    "src/",
    "scripts/generate-skill-inventory.mjs",
    "scripts/generate-spend-snapshot.mjs",
    "scripts/togglelogic-runtime-refresh.mjs",
    "openclaw.plugin.json",
    "LICENSE",
    "NOTICE.md",
    "TRADEMARKS.md",
    "README.md",
    "CHANGELOG.md",
    "docs/"
  ],
  "peerDependencies": {
    "openclaw": "*"
  },
  "openclaw": {
    "extensions": ["./src/index.js"],
    "install": { "minHostVersion": ">=2026.9.4" },
    "compat": { "pluginApi": ">=2026.5.2" },
    "build": { "openclawVersion": "2026.9.4" }
  }
}
