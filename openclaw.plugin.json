{
  "id": "togglelogic",
  "name": "ToggleLogic",
  "version": "2.0.0",
  "description": "Generic model routing, approvals, audit records, and cost visibility for OpenClaw. ToggleLogic Free includes no assistant, memory, skills, or business workflow policy.",
  "activation": { "onStartup": true },
  "enabledByDefault": true,
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mode": { "type": "string", "enum": ["auto", "passthrough", "configured", "cheap", "intelligence"], "default": "auto" },
      "logging": { "type": "object", "additionalProperties": false, "properties": { "enabled": { "type": "boolean" }, "path": { "type": "string" }, "rotateSizeMb": { "type": "integer", "minimum": 1 } } },
      "configuredRoutes": { "type": "object", "description": "Static host-supplied structured-label routes. Prompt text is never inspected.", "additionalProperties": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" } },
      "cheapHeuristic": { "type": "object", "additionalProperties": false, "properties": { "default": { "type": "string" }, "order": { "type": "array", "items": { "type": "string" } } } },
      "intelligence": { "type": "object", "additionalProperties": false, "properties": { "enabled": { "type": "boolean" }, "path": { "type": "string" }, "registryPath": { "type": "string" }, "shadow": { "type": "boolean" }, "fallbackOnError": { "type": "boolean" }, "allowReleaseCandidate": { "type": "boolean" } } },
      "ownerOverride": { "type": "object", "additionalProperties": false, "properties": { "enabled": { "type": "boolean" }, "statePath": { "type": "string" }, "askConsumer": { "type": "string" } } },
      "audit": { "type": "object", "additionalProperties": false, "properties": { "enabled": { "type": "boolean" }, "path": { "type": "string" }, "rotateSizeMb": { "type": "integer", "minimum": 1 } } },
      "costVisibility": { "type": "object", "additionalProperties": true },
      "governedEscalation": { "type": "object", "additionalProperties": true },
      "features": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "routing": { "$ref": "#/$defs/feature" },
          "ownerOverrideAsk": { "$ref": "#/$defs/feature" },
          "costVisibility": { "$ref": "#/$defs/feature" },
          "governedEscalation": { "$ref": "#/$defs/feature" }
        }
      }
    },
    "$defs": { "feature": { "type": "object", "additionalProperties": false, "properties": { "enabled": { "type": "boolean", "default": false } } } }
  }
}
