{
  "agents": { "defaults": { "model": "anthropic/claude-sonnet-5" } },
  "plugins": {
    "allow": ["togglelogic"],
    "load": { "paths": ["<MANAGED_PLUGIN_ROOT>"] },
    "entries": {
      "togglelogic": {
        "enabled": true,
        "hooks": { "allowConversationAccess": true },
        "subagent": { "allowModelOverride": true },
        "config": {
          "mode": "passthrough",
          "features": {
            "routing": { "enabled": true },
            "skillRouting": { "enabled": true },
            "costVisibility": { "enabled": true }
          },
          "intelligence": {
            "enabled": true,
            "path": "~/togglelogic-intelligence",
            "shadow": true,
            "allowReleaseCandidate": true,
            "skillProfilesPath": "~/.openclaw/togglelogic/skill-routing-profiles.json"
          },
          "skillRouting": {
            "ownerTimezone": "America/New_York",
            "inventorySnapshotPath": "~/.openclaw/togglelogic/skill-inventory.snapshot.json",
            "inventoryMaxAgeHours": 24,
            "spend": {
              "enabled": true,
              "snapshotPath": "~/.openclaw/togglelogic/cloud-spend.snapshot.json",
              "maxAgeHours": 26,
              "timezone": "America/New_York",
              "localProviders": ["ollama"],
              "finiteCloudBudgetApplies": true,
              "delta": { "enabled": false }
            },
            "skillRequirements": {
              "default": {
                "requiredTier": "tool_calling_strong",
                "requiresTools": true,
                "privacy": "cloud_allowed"
              },
              "skills": {
                "microsoft-graph": { "requiredTier": "tool_calling_strong", "requiresTools": true, "privacy": "cloud_allowed" },
                "zoom-meetings": { "requiredTier": "tool_calling_strong", "requiresTools": true, "privacy": "cloud_allowed" },
                "gog": { "requiredTier": "tool_calling_strong", "requiresTools": true, "privacy": "cloud_allowed" }
              }
            },
            "intentRecipes": [
              {
                "id": "high-precision-meeting-prep",
                "allTerms": ["meeting"],
                "anyTerms": ["prepare", "prep", "brief", "briefing", "get ready", "ready for", "prep me"],
                "skillIds": ["microsoft-graph", "zoom-meetings"]
              },
              {
                "id": "outlook-mail",
                "allTerms": ["outlook"],
                "anyTerms": ["email", "emails", "mail", "inbox", "message", "messages"],
                "skillIds": ["microsoft-graph"]
              },
              {
                "id": "zoom-recording",
                "allTerms": ["zoom"],
                "anyTerms": ["transcript", "transcripts", "recording", "recordings", "recorded"],
                "skillIds": ["zoom-meetings"]
              },
              {
                "id": "gmail-mail",
                "allTerms": ["gmail"],
                "anyTerms": ["email", "emails", "mail", "inbox", "message", "messages", "send", "draft", "drafts", "reply", "search", "read", "find"],
                "skillIds": ["gog"]
              }
            ],
            "skillIdentities": {
              "microsoft-graph": {
                "label": "owner-mailbox:Al-Harlow",
                "mailbox": "Al Harlow's Microsoft 365 / Outlook mailbox (the owner's own mailbox)",
                "senderIdentity": "Al Harlow (the owner)",
                "authority": "You are acting as Al Harlow's assistant inside Al's own Microsoft 365 mailbox. Read, compose, and (only on an explicit owner instruction) send email as Al / on behalf of Al.",
                "sendPolicy": "A specific owner instruction to send a NAMED message authorizes exactly that send. A general write/compose/draft/reply request is DRAFT-ONLY: prepare the draft and stop; do not send externally until the owner confirms the exact message."
              },
              "gog": {
                "label": "sam-mailbox:clickitco@gmail.com",
                "mailbox": "clickitco@gmail.com — SAM's OWN Gmail account",
                "senderIdentity": "SAM, in SAM's own identity",
                "authority": "This is SAM's own Gmail mailbox (clickitco@gmail.com). Any mail from this account is from SAM as SAM. NEVER write, sign, or send as Al Harlow from this account, and never impersonate Al.",
                "sendPolicy": "A specific owner instruction to send a NAMED message authorizes exactly that send. A general write/compose/draft/reply request is DRAFT-ONLY: prepare the draft and stop; do not send externally until the owner confirms the exact message."
              }
            },
            "scope": {
              "enabled": true,
              "allowGlobal": false,
              "requireOwner": true,
              "channels": ["telegram"],
              "accountIds": ["default"],
              "ownerSenderIds": ["<OWNER_TELEGRAM_PEER_ID>"]
            }
          },
          "costVisibility": {
            "log": { "enabled": true, "path": "~/.openclaw/logs/togglelogic-cost.jsonl" },
            "pricing": { "sourceUrl": "https://models.dev/api.json", "cachePath": "~/.openclaw/togglelogic/pricing-cache.json" }
          },
          "audit": { "enabled": true, "path": "~/.openclaw/logs/togglelogic-audit.jsonl" }
        }
      }
    }
  }
}
