{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://togglelogic.ai/schema/decision-api/v1/decision-response.json",
  "title": "ToggleLogic Decision API v1 — response (DRAFT)",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "correlationId", "decision", "reason", "policyDigest", "costEstimate", "engine"],
  "properties": {
    "apiVersion": { "const": "togglelogic.decision/v1" },
    "correlationId": { "type": "string", "maxLength": 128 },
    "decision": {
      "type": "object", "additionalProperties": false, "required": ["action"],
      "properties": {
        "action": { "enum": ["route", "passthrough", "block"] },
        "ref": { "type": "string", "maxLength": 512 },
        "provider": { "type": "string", "maxLength": 128 },
        "model": { "type": "string", "maxLength": 384 }
      },
      "if": { "properties": { "action": { "const": "route" } } },
      "then": { "required": ["ref"] }
    },
    "reason": {
      "enum": ["owner_override", "task_pin", "user_selection", "request_selection", "configured", "cheap_default", "intelligence", "pin", "intelligence_shadow", "provider_unavailable", "fallback_unresolved", "passthrough", "fallback", "blocked", "work_class", "work_class_floor_unmet", "integration_route_hint", "integration_route_hint_unusable"]
    },
    "rationale": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "matchedRule": { "type": "string", "maxLength": 256 },
        "details": { "type": "object", "description": "Allowlisted keys only; see the M2 field allowlists." }
      }
    },
    "policyDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "costEstimate": {
      "type": "object", "additionalProperties": false, "required": ["priced", "usd"],
      "properties": {
        "priced": { "type": "boolean" },
        "usd": { "type": ["number", "null"], "minimum": 0 },
        "basis": { "enum": ["usage_estimate", "none"] },
        "unpricedReason": { "type": "string", "maxLength": 256 }
      },
      "if": { "properties": { "priced": { "const": false } } },
      "then": { "properties": { "usd": { "const": null } }, "required": ["unpricedReason"] }
    },
    "engine": {
      "type": "object", "additionalProperties": false, "required": ["product", "version"],
      "properties": {
        "product": { "const": "togglelogic-free" },
        "version": { "type": "string" },
        "seamState": { "enum": ["disabled", "detecting", "available", "absent"] }
      }
    },
    "audit": {
      "type": "object", "additionalProperties": false,
      "properties": { "recordId": { "type": "string" } }
    },
    "pins": {
      "type": "object", "additionalProperties": false,
      "description": "Owner-pin snapshot for this turn (M6 §4.2). Carried on every decision from step 2 onward so a host can show what is pinned, to what, and why — including a pin that exists but was not applied. task/all are null when no pin is configured for that scope.",
      "required": ["labelSeen", "task", "all"],
      "properties": {
        "labelSeen": { "type": ["string", "null"], "maxLength": 160 },
        "task": { "$ref": "#/$defs/pinScope" },
        "all": { "$ref": "#/$defs/pinScope" }
      }
    }
  },
  "$defs": {
    "pinScope": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["scope", "status", "reason", "pin_target", "resolved_ref"],
      "properties": {
        "scope": { "type": "string", "maxLength": 160 },
        "status": { "enum": ["applied", "not_applied"] },
        "reason": { "enum": ["applied", "expired", "unavailable", "outranked_by_user", "outranked_by_request", "outranked_by_task_pin", "no_label", "malformed", "inactive"] },
        "pin_target": { "enum": ["model", "family"] },
        "model_ref": { "type": "string", "maxLength": 512 },
        "family": { "type": "string", "maxLength": 512 },
        "resolved_ref": { "type": ["string", "null"], "maxLength": 512 },
        "resolution_reason": { "type": "string", "maxLength": 128 },
        "set_by": { "type": "string", "maxLength": 128 },
        "set_at_ms": { "type": "integer", "minimum": 0 },
        "expires_at_ms": { "type": ["integer", "null"], "minimum": 0 },
        "no_expiry": { "type": "boolean" }
      }
    }
  }
}
