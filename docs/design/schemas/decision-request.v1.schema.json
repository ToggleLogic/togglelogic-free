{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://togglelogic.ai/schema/decision-api/v1/decision-request.json",
  "title": "ToggleLogic Decision API v1 — request (DRAFT)",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "candidates"],
  "properties": {
    "apiVersion": { "const": "togglelogic.decision/v1" },
    "requestId": { "type": "string", "maxLength": 128 },
    "tenant": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "costCenter": { "type": "string", "maxLength": 128 }
      }
    },
    "work": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "label": { "type": ["string", "null"], "maxLength": 128 },
        "labelSource": { "enum": ["host", "none"] },
        "capabilityNeeds": { "type": "array", "items": { "enum": ["attachments", "vision", "tools"] }, "uniqueItems": true }
      }
    },
    "dataClass": {
      "type": "object", "additionalProperties": false, "required": ["label", "source"],
      "properties": {
        "label": { "enum": ["local_only", "local_preferred", "cloud_allowed"] },
        "source": { "const": "host" }
      }
    },
    "requested": {
      "type": "object", "additionalProperties": false, "required": ["source"],
      "properties": {
        "ref": { "$ref": "#/$defs/modelRef" },
        "source": { "enum": ["user", "request", "auto", "default", "none"] }
      }
    },
    "defaultRef": { "$ref": "#/$defs/modelRef" },
    "candidates": {
      "type": "array", "maxItems": 512,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["ref"],
        "properties": {
          "ref": { "$ref": "#/$defs/modelRef" },
          "lineage": { "type": "string", "maxLength": 512 },
          "local": { "type": "boolean" },
          "surfaces": { "type": "array", "items": { "type": "string", "maxLength": 64 } },
          "releaseDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "fallbacks": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/modelRef" } },
    "hostSignals": {
      "type": "object", "additionalProperties": false,
      "properties": { "unavailableProviders": { "type": "array", "items": { "type": "string", "maxLength": 128 } } }
    },
    "usageEstimate": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 }
      }
    },
    "content": {
      "description": "Opaque. Forwarded only to a licensed decision provider when the host opts in. Never read by the Free core, never logged, never audited.",
      "type": "object"
    }
  },
  "$defs": {
    "modelRef": { "type": "string", "pattern": "^[^/\\s]+/[^\\s]+$", "maxLength": 512 }
  }
}
